            "minimum": 0.5,
            "title": "Scale",
            "type": "number"
          }
        },
        "title": "ExportImageParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "file_key": {
            "description": "Resolved Figma file key",
