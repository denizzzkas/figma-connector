{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.13",
  "app_id": "figma-connector",
  "version": "1.0.0",
  "name": "Figma Connector",
  "description": "Read-only Figma bridge: paste a file or frame URL and Webbee can look up file structure, inspect a specific node's layers and properties, or export a node as PNG/SVG/PDF. Uses your own Figma Personal Access Token — read scope only, no canvas edits.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "figma-connector:read"
  ],
  "tools": [
    {
      "name": "get_file",
      "description": "Look up a Figma file's name and page/frame structure from a pasted file URL or file key. Read-only.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "figma_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A Figma file or frame URL, e.g. https://www.figma.com/design/<key>/<name>?node-id=19-207",
            "title": "Figma Url"
          },
          "file_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma file key, if not passing figma_url.",
            "title": "File Key"
          }
        },
        "title": "GetFileParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "FigmaPage": {
            "properties": {
              "id": {
                "description": "Page node id",
                "title": "Id",
                "type": "string"
              },
              "name": {
                "description": "Page name",
                "title": "Name",
                "type": "string"
              },
              "top_level_frame_count": {
                "description": "Number of top-level frames/children on this page",
                "title": "Top Level Frame Count",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "top_level_frame_count"
            ],
            "title": "FigmaPage",
            "type": "object"
          }
        },
        "properties": {
          "file_key": {
            "description": "Resolved Figma file key",
            "title": "File Key",
            "type": "string"
          },
          "file_name": {
            "description": "Figma file name",
            "title": "File Name",
            "type": "string"
          },
          "last_modified": {
            "description": "ISO timestamp of last edit",
            "title": "Last Modified",
            "type": "string"
          },
          "pages": {
            "description": "Top-level pages in the file",
            "items": {
              "$ref": "#/$defs/FigmaPage"
            },
            "title": "Pages",
            "type": "array"
          }
        },
        "required": [
          "file_key",
          "file_name",
          "last_modified",
          "pages"
        ],
        "title": "GetFileResult",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "figma_connector"
    },
    {
      "name": "get_node",
      "description": "Inspect one specific Figma node/frame (by URL or file_key+node_id): its size, type, and every child layer's real design data — fill colors/gradients, stroke color+weight, shadows/blur effects, corner radius, opacity, and full text typography (font, size, weight, line height, letter spacing, alignment). Pass max_depth>1 to also see layers nested inside groups/auto-layout frames/component instances (each tagged with its depth and parent_path). Pass include_geometry=true to also get exact vector outlines as SVG path data. Read-only.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "figma_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A Figma frame URL with ?node-id=..., e.g. https://www.figma.com/design/<key>/<name>?node-id=19-207",
            "title": "Figma Url"
          },
          "file_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma file key, if not embedded in figma_url.",
            "title": "File Key"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma node id, e.g. '19:207' or '19-207'.",
            "title": "Node Id"
          },
          "include_geometry": {
            "default": false,
            "description": "Also fetch resolved vector curves (SVG path data) for VECTOR/BOOLEAN_OPERATION/STAR/LINE/ELLIPSE/POLYGON child layers. Costs one extra Figma API call — leave off unless you actually need the exact curve geometry.",
            "title": "Include Geometry",
            "type": "boolean"
          },
          "max_depth": {
            "default": 1,
            "description": "How many levels deep to walk into nested children. 1 = only direct children (default, matches old behaviour). Raise this to see layers nested inside groups/components/auto-layout frames, e.g. an icon inside a button inside a card.",
            "maximum": 8,
            "minimum": 1,
            "title": "Max Depth",
            "type": "integer"
          }
        },
        "title": "GetNodeParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "FigmaColor": {
            "properties": {
              "hex": {
                "description": "Color as '#rrggbb' (or '#rrggbbaa' if alpha < 1)",
                "title": "Hex",
                "type": "string"
              },
              "r": {
                "description": "Red channel, 0-1 (raw Figma value)",
                "title": "R",
                "type": "number"
              },
              "g": {
                "description": "Green channel, 0-1 (raw Figma value)",
                "title": "G",
                "type": "number"
              },
              "b": {
                "description": "Blue channel, 0-1 (raw Figma value)",
                "title": "B",
                "type": "number"
              },
              "a": {
                "default": 1.0,
                "description": "Alpha, 0-1",
                "title": "A",
                "type": "number"
              }
            },
            "required": [
              "hex",
              "r",
              "g",
              "b"
            ],
            "title": "FigmaColor",
            "type": "object"
          },
          "FigmaEffect": {
            "properties": {
              "type": {
                "description": "DROP_SHADOW, INNER_SHADOW, LAYER_BLUR, or BACKGROUND_BLUR",
                "title": "Type",
                "type": "string"
              },
              "visible": {
                "default": true,
                "title": "Visible",
                "type": "boolean"
              },
              "radius": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Blur/shadow radius in px",
                "title": "Radius"
              },
              "spread": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Shadow spread in px (shadows only)",
                "title": "Spread"
              },
              "color": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/FigmaColor"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Shadow color (shadows only)"
              },
              "offset_x": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Shadow x offset in px (shadows only)",
                "title": "Offset X"
              },
              "offset_y": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Shadow y offset in px (shadows only)",
                "title": "Offset Y"
              }
            },
            "required": [
              "type"
            ],
            "title": "FigmaEffect",
            "type": "object"
          },
          "FigmaGradientStop": {
            "properties": {
              "position": {
                "description": "Position along the gradient axis, 0-1",
                "title": "Position",
                "type": "number"
              },
              "color": {
                "$ref": "#/$defs/FigmaColor"
              }
            },
            "required": [
              "position",
              "color"
            ],
            "title": "FigmaGradientStop",
            "type": "object"
          },
          "FigmaLayer": {
            "properties": {
              "id": {
                "description": "Layer/node id",
                "title": "Id",
                "type": "string"
              },
              "name": {
                "description": "Layer name",
                "title": "Name",
                "type": "string"
              },
              "type": {
                "description": "Figma node type, e.g. FRAME, TEXT, VECTOR, COMPONENT",
                "title": "Type",
                "type": "string"
              },
              "depth": {
                "default": 1,
                "description": "Nesting depth relative to the requested node (1 = direct child)",
                "title": "Depth",
                "type": "integer"
              },
              "parent_path": {
                "default": "",
                "description": "Ancestor layer names joined by ' > ', e.g. 'Card > Button'",
                "title": "Parent Path",
                "type": "string"
              },
              "width": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Bounding box width in px",
                "title": "Width"
              },
              "height": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Bounding box height in px",
                "title": "Height"
              },
              "characters": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Text content, only present for TEXT layers",
                "title": "Characters"
              },
              "opacity": {
                "default": 1.0,
                "description": "Layer opacity, 0-1",
                "title": "Opacity",
                "type": "number"
              },
              "corner_radius": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Uniform corner radius in px, if set",
                "title": "Corner Radius"
              },
              "fills": {
                "description": "Fill paints (solid color or gradient)",
                "items": {
                  "$ref": "#/$defs/FigmaPaint"
                },
                "title": "Fills",
                "type": "array"
              },
              "strokes": {
                "description": "Stroke paints",
                "items": {
                  "$ref": "#/$defs/FigmaPaint"
                },
                "title": "Strokes",
                "type": "array"
              },
              "stroke_weight": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Stroke thickness in px",
                "title": "Stroke Weight"
              },
              "effects": {
                "description": "Shadows and blurs",
                "items": {
                  "$ref": "#/$defs/FigmaEffect"
                },
                "title": "Effects",
                "type": "array"
              },
              "text_style": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/FigmaTextStyle"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Typography, only present for TEXT layers"
              },
              "fill_geometry_svg_paths": {
                "description": "Resolved outline as SVG path 'd' strings — only populated when include_geometry=True and the layer has vector geometry",
                "items": {
                  "type": "string"
                },
                "title": "Fill Geometry Svg Paths",
                "type": "array"
              }
            },
            "required": [
              "id",
              "name",
              "type"
            ],
            "title": "FigmaLayer",
            "type": "object"
          },
          "FigmaPaint": {
            "properties": {
              "type": {
                "description": "SOLID, GRADIENT_LINEAR, GRADIENT_RADIAL, GRADIENT_ANGULAR, GRADIENT_DIAMOND, IMAGE, or PATTERN",
                "title": "Type",
                "type": "string"
              },
              "visible": {
                "default": true,
                "title": "Visible",
                "type": "boolean"
              },
              "opacity": {
                "default": 1.0,
                "description": "Paint opacity, 0-1",
                "title": "Opacity",
                "type": "number"
              },
              "color": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/FigmaColor"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Solid color, only for type=SOLID"
              },
              "gradient_stops": {
                "description": "Color stops, only for gradient types",
                "items": {
                  "$ref": "#/$defs/FigmaGradientStop"
                },
                "title": "Gradient Stops",
                "type": "array"
              }
            },
            "required": [
              "type"
            ],
            "title": "FigmaPaint",
            "type": "object"
          },
          "FigmaTextStyle": {
            "properties": {
              "font_family": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Font Family"
              },
              "font_weight": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Numeric font weight, e.g. 400, 700",
                "title": "Font Weight"
              },
              "font_size": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Font size in px",
                "title": "Font Size"
              },
              "line_height_px": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Line Height Px"
              },
              "letter_spacing": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Space between characters in px",
                "title": "Letter Spacing"
              },
              "text_align_horizontal": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "LEFT, CENTER, RIGHT, or JUSTIFIED",
                "title": "Text Align Horizontal"
              },
              "text_align_vertical": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "TOP, CENTER, or BOTTOM",
                "title": "Text Align Vertical"
              },
              "text_case": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "ORIGINAL, UPPER, LOWER, or TITLE",
                "title": "Text Case"
              },
              "text_decoration": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "NONE, UNDERLINE, or STRIKETHROUGH",
                "title": "Text Decoration"
              }
            },
            "title": "FigmaTextStyle",
            "type": "object"
          }
        },
        "properties": {
          "file_key": {
            "description": "Resolved Figma file key",
            "title": "File Key",
            "type": "string"
          },
          "node_id": {
            "description": "Resolved Figma node id",
            "title": "Node Id",
            "type": "string"
          },
          "node_name": {
            "description": "Name of the requested node",
            "title": "Node Name",
            "type": "string"
          },
          "node_type": {
            "description": "Figma node type of the requested node",
            "title": "Node Type",
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Node bounding box width in px",
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Node bounding box height in px",
            "title": "Height"
          },
          "layers": {
            "description": "Direct child layers of the requested node",
            "items": {
              "$ref": "#/$defs/FigmaLayer"
            },
            "title": "Layers",
            "type": "array"
          }
        },
        "required": [
          "file_key",
          "node_id",
          "node_name",
          "node_type",
          "layers"
        ],
        "title": "GetNodeResult",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "figma_connector"
    },
    {
      "name": "export_image",
      "description": "Export a specific Figma node as a PNG, SVG, PDF or JPG and return a temporary download URL. Read-only.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "figma_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A Figma frame URL with ?node-id=..., e.g. https://www.figma.com/design/<key>/<name>?node-id=19-207",
            "title": "Figma Url"
          },
          "file_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma file key, if not embedded in figma_url.",
            "title": "File Key"
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma node id, if not embedded in figma_url.",
            "title": "Node Id"
          },
          "format": {
            "default": "png",
            "description": "Export format: 'png', 'svg', 'pdf', or 'jpg'.",
            "title": "Format",
            "type": "string"
          },
          "scale": {
            "default": 2.0,
            "description": "Export scale for png/jpg, 0.5-4.0.",
