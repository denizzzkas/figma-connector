            "title": "Image Url",
            "type": "string"
          }
        },
        "required": [
          "file_key",
          "node_id",
          "format",
          "image_url"
        ],
        "title": "ExportImageResult",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "figma_connector"
    },
    {
      "name": "list_styles",
      "description": "List every named local style (design token) defined in a Figma file — color/fill styles, text styles, effect styles and grid styles — with their name and style_id. Use this to see the file's real design-system palette/type-scale by name (e.g. 'Navy/900', 'Heading/H1') rather than reading raw hex values off individual layers. Read-only.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "figma_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A Figma file URL, e.g. https://www.figma.com/design/<key>/<name>",
            "title": "Figma Url"
          },
          "file_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Figma file key, if not passing figma_url.",
            "title": "File Key"
          }
        },
        "title": "FileScopedParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "FigmaStyleInfo": {
            "properties": {
              "style_id": {
                "description": "Style node id (usable as a node_id with get_node)",
                "title": "Style Id",
                "type": "string"
              },
              "name": {
                "description": "Style name, e.g. 'Navy/900' or 'Heading/H1'",
                "title": "Name",
                "type": "string"
              },
              "style_type": {
                "description": "FILL, TEXT, EFFECT, or GRID",
                "title": "Style Type",
                "type": "string"
              },
              "description": {
                "default": "",
                "description": "Author-written description, if any",
                "title": "Description",
                "type": "string"
              }
            },
            "required": [
              "style_id",
              "name",
              "style_type"
            ],
            "title": "FigmaStyleInfo",
            "type": "object"
          }
        },
        "properties": {
          "file_key": {
            "description": "Resolved Figma file key",
            "title": "File Key",
            "type": "string"
          },
          "styles": {
            "description": "Every named local style defined in the file",
            "items": {
              "$ref": "#/$defs/FigmaStyleInfo"
            },
            "title": "Styles",
            "type": "array"
          }
        },
        "required": [
          "file_key",
          "styles"
        ],
        "title": "ListStylesResult",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "figma_connector"
    },
    {
      "name": "list_components",
      "description": "List every reusable component defined in a Figma file — name, component_id (usable directly as a node_id with get_node), description, and its parent component_set_id if it's a variant. Use this to discover a design system's building blocks (buttons, icons, cards) by name before inspecting one in detail with get_node. Read-only.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "figma_url": {
            "anyOf": [
              {
